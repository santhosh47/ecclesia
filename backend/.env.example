# ==============================================================================
# Ecclesia Church Management System - Backend Environment Configuration Example
# Copy this file to '.env' in production or staging and update the values.
# ==============================================================================

# --- Application Core ---
APP_NAME="Ecclesia Church Management System"
ENVIRONMENT=development               # Options: development, staging, production
DEBUG=true                            # Set to false in production
API_V1_PREFIX=/api/v1

# --- Database Configuration ---
# SQLite default for local development:
DATABASE_URL=sqlite:///./ecclesia.db
# PostgreSQL for production (example):
# DATABASE_URL=postgresql://ecclesia_user:secure_password@localhost:5432/ecclesia_db

# --- Security & Authentication ---
# Secret key used for signing JWT authentication tokens (RFC 7519 HS256).
# IMPORTANT: In production, generate a secure random 64-character secret!
SECRET_KEY=ecclesia-production-super-secret-key-change-in-env-2026
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480       # Token validity (480 min = 8 hours)

# --- Cross-Origin Resource Sharing (CORS) ---
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Localization & Region Settings ---
# Default country / currency format mode: 'IN' (India - ₹ / Lakhs) or 'GLOBAL' ($ / Thousands)
DEFAULT_LOCALIZATION_MODE=IN

# --- Observability & Logging ---
LOG_LEVEL=INFO                        # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/ecclesia.log            # Path to rotating file log (relative to backend or absolute)
