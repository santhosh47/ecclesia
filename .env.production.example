# Ecclesia Production Environment Configuration Template
# Rename this file to .env.production on your server and NEVER commit secrets to git.

# Application Environment
ENVIRONMENT=production
DEBUG=false
PORT=8000

# Security (Generate using: openssl rand -hex 32)
SECRET_KEY=replace-with-a-64-character-random-hex-string-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL Database Configuration
DB_USER=ecclesia_admin
DB_PASSWORD=replace-with-a-strong-database-password-2026!
DB_NAME=ecclesia_production
DATABASE_URL=postgresql+psycopg2://ecclesia_admin:replace-with-a-strong-database-password-2026!@db:5432/ecclesia_production

# CORS Origins (Authoritative church domain and admin portal)
CORS_ORIGINS=https://admin.yourchurch.org,https://yourchurch.org

# Logging & Monitoring
LOG_LEVEL=INFO
LOG_FILE=logs/ecclesia.log

# Automated Pastoral Alerts & Notifications
# Church SMTP Settings
SMTP_HOST=smtp.yourchurch.org
SMTP_PORT=587
SMTP_USER=pastoral-alerts@yourchurch.org
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Ecclesia Pastoral Care <pastoral-alerts@yourchurch.org>

# WhatsApp Business Cloud API (Meta)
WHATSAPP_API_URL=https://graph.facebook.com/v19.0/YOUR_PHONE_NUMBER_ID/messages
WHATSAPP_API_TOKEN=your-meta-whatsapp-bearer-token

# Web Push Notifications (VAPID Keys)
VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:pastor@yourchurch.org
